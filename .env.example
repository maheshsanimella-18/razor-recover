# RazorRecover Environment Variables
# Copy this file to .env and insert your Gemini API Key.
# If no key is provided, the system gracefully falls back to the local deterministic policy engine.

GEMINI_API_KEY=your_gemini_api_key_here
RAZORPAY_KEY_ID=rzp_test_sample_key
RAZORPAY_KEY_SECRET=sample_secret_key
DATABASE_URL=sqlite:///./razor_recover.db
EXECUTION_MODE=SIMULATED_TEST_MODE
